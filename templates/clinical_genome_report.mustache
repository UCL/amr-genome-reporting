<!DOCTYPE html>
<head>
<meta name="viewport" content="width=device-width" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<link rel="stylesheet" type="text/css" href="templates/style.css" />
<!--
<style>
 {{>templates/style.css}}
</style>
-->
<title>Clinical Genome Report: id-{{id}}</title>
</head>

<body>

    <section class="report">
        <h1 class="clinical">CLINICAL GENOME REPORT</h1>
        <div class="info-grid">
            <div class="list bordered">
              {{#header}}
                <item>
                    <label>{{ label }}</label>
                    <value>{{ value }}</value>
                </item>
              {{/header}}
            </div>
        </div>

        <h2 class="section-title clinical">Section 1: Clinical microbiology</h2>
        <div class="summary-box clinical list">
            <item>
                <label>Summary</label>
                <value>
                    {{#clinical_microbiology.summary}}
                        <span style="font-style: {{font}};">{{text}}</span>
                    {{/clinical_microbiology.summary}}
                </value>
            </item>
        </div>

        <div class="summary-box organism list">
            <item>
                <label>Organism</label>
                <value style="font-style: italic;">{{clinical_microbiology.organism}}</value>
            </item>
        </div>

        <div class="content typing">
            <div class="list">
                <item>
                    <label>Bacterial typing</label>
                    <value class="description">
                        {{clinical_microbiology.bacterial_typing.description}}
                        <a href="{{clinical_microbiology.bacterial_typing.url}}" target="_blank">
                            <span style="white-space: nowrap">{{clinical_microbiology.bacterial_typing.url}}</span>
                        </a>
                    </value>
                </item>
            </div>

            <div class="info-grid">
                <div class="st">
                    {{clinical_microbiology.bacterial_typing.typing}}<br />
                Sequence type (ST): {{clinical_microbiology.bacterial_typing.sequence_type}}
                </div>
                <div class="profile">
                    <table>
                        <tr>
                            <td rowspan="2" class="profile_heading">Profile:</td>
                            {{#clinical_microbiology.bacterial_typing.profile}}
                                <th>{{gene}}</th>
                            {{/clinical_microbiology.bacterial_typing.profile}}
                        </tr>
                        <tr>
                            {{#clinical_microbiology.bacterial_typing.profile}}
                                <td>{{allele}}</td>
                            {{/clinical_microbiology.bacterial_typing.profile}}
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="content amr">
            <div class="list">
                <item>
                    <label>Antibiotic resistance determinants</label>
                    <value class="description">
                        Genetically determined resistance mechanisms have been identified. 
                        Genetic variants (homologs) are highlighted *. "None found" means no resistance mechanisms 
                        have been identified in the antimicrobial resistance databases that exist at the time of 
                        reporting, correlate with phenotype. It is best practice to review these with the phenotypic 
                        antibiotic susceptibility profile. 
                        <a href="https://github.com/klebgenomics/Kleborate" target="_blank">
                            <span style="white-space:nowrap">https://github.com/klebgenomics/Kleborate</span>
                        </a>.
                    </value>
                </item>
            </div>

            <div class="scrollable">
                <table class="amr">
                    <tr>
                        <th>Drug class</th>
                        <th>Acquired genotypes</th>
                    </tr>
                    {{#clinical_microbiology.antibiotic_resistance_determinants}}
                        <tr>
                            <td>{{drug_class}}</td>
                            <td>{{acquired_genotypes}}</td>
                        </tr>
                    {{/clinical_microbiology.antibiotic_resistance_determinants}}
                </table>
            </div>
        </div>

        <div class="content capsule">
            <div class="list">
                <item>
                    <label>Capsule and O typing</label>
                    <value class="description">
                        {{clinical_microbiology.capsule_typing.description}}
                        <a href="{{clinical_microbiology.capsule_typing.url}}" target="_blank">
                            <span style="white-space: nowrap">
                                {{clinical_microbiology.capsule_typing.url}}
                            </span>
                        </a>.
                    </value>
                </item>
            </div>
            <div class="info-grid">
                {{#clinical_microbiology.capsule_typing.results}}
                    <div class="list">
                        <item>
                            <label class="discrete">
                                <em>{{type}}</em>
                            </label>
                            <value>
                                <em>{{value}}</em>
                            </value>
                        </item>
                    </div>
                {{/clinical_microbiology.capsule_typing.results}}
            </div>
        </div>

        <div class="content virulence">
            <div class="list">
                <item>
                    <label>Virulence factors</label>
                    <value>
                        {{clinical_microbiology.virulence_determinants.description}}
                        <a href="{{clinical_microbiology.virulence_determinants.url}}" target="_blank">
                            <span style="white-space:nowrap">
                                {{clinical_microbiology.virulence_determinants.url}}
                            </span>
                        </a>.
                    </value>
                </item>
                <div class="list">
                    <item>
                        <label class="discrete">Virulence score</label>
                        <value>
                            {{clinical_microbiology.virulence_determinants.virulence_score}}
                        </value>
                    </item>
                </div>
                <div class="info-grid">
                    <div class="list">
                        <item><label>Acquired siderophores</label></item>
                        {{#clinical_microbiology.virulence_determinants.acquired_siderophores}}
                            <item>
                                <label class="discrete">{{type}}</label>
                                <value>{{value}}</value>
                            </item>
                        {{/clinical_microbiology.virulence_determinants.acquired_siderophores}}
                    </div>
                    <div class="list">
                        <item><label>Other factors</label></item>
                        {{#clinical_microbiology.virulence_determinants.other_factors}}
                            <item>
                                <label class="discrete">{{type}}</label>
                                <value>{{value}}</value>
                            </item>
                        {{/clinical_microbiology.virulence_determinants.other_factors}}
                    </div>
                </div>
            </div>
        </div>

        <h2 class="section-title public_health" style="margin-top: 2rem;">
            Section 2: Public health and Infection prevention and control
        </h2>
        <div class="summary-box public_health list">
            <item>
                <label>Summary</label>
                <value>
                    {{#public_health.summary}}
                        <span style="font-style: {{font}};">{{text}}</span>
                    {{/public_health.summary}}
                </value>
            </item>
        </div>

        <div class="content typing">
            <div class="list">
                <item>
                    <label>Bacterial typing</label>
                    <value class="description">
                        {{public_health.bacterial_typing.description}}
                        <a href="{{public_health.bacterial_typing.url}}" target="_blank">
                            <span style="white-space: nowrap">{{public_health.bacterial_typing.url}}</span>
                        </a>
                    </value>
                </item>
            </div>

            <div class="info-grid">
                <div class="st">
                    {{public_health.bacterial_typing.typing}}<br />
                    Sequence type (ST): {{public_health.bacterial_typing.sequence_type}}
                </div>
                <div class="profile">
                    <table>
                        <tr>
                            <td rowspan="2" class="profile_heading">Profile:</td>
                            {{#public_health.bacterial_typing.profile}}
                                <th>{{gene}}</th>
                            {{/public_health.bacterial_typing.profile}}
                        </tr>
                        <tr>
                            {{#public_health.bacterial_typing.profile}}
                                <td>{{allele}}</td>
                            {{/public_health.bacterial_typing.profile}}
                        </tr>
                    </table>
                </div>
            </div>

            <div class="info-grid">
                {{#public_health.lincodes}}
                    <div class="list">
                        <item>
                            <label class="discrete">{{label}}</label>
                            <value>{{value}}</value>
                        </item>
                    </div>
                {{/public_health.lincodes}}
            </div>

            <div class="list">
                <item>
                    <label class="discrete">LIN (Life Identification Number)</label>
                    <value>{{public_health.lin}}</value>
                </item>
            </div>
        </div>

        <div class="content plasmid">
            <div class="list">
                <item>
                    <label>Plasmid Inc typing</label>
                    <value class="description">
                        {{public_health.plasmid.description}}
                        <a href="{{public_health.plasmid.url}}" target="_blank">
                            <span style="white-space: nowrap">
                                {{public_health.plasmid.url}}
                            </span>
                        </a>
                    </value>
                </item>
                <item>
                    <label class="discrete">Plasmid type</label>
                    <value>{{public_health.plasmid.type}}</value>
                </item>
            </div>
        </div>

        <div class="content outbreak">
            <div class="list">
                <item>
                    <label>Outbreak analysis</label>
                    <value class="description">
                        {{public_health.outbreak.description}}
                        <a href="{{public_health.outbreak.url}}" target="_blank">
                            <span style="white-space: nowrap">
                                {{public_health.outbreak.url}}
                            </span>
                        </a>.
                    </value>
                </item>
            </div>
            <p class="heading">Allele based:</p>
            <div class="list">
                <item>
                    <label class="discrete">LIN (Life Identification Number)</label>
                    <value>{{public_health.outbreak.lin}}</value>
                </item>
                <p class="note" style="margin-top:0">(based on cgMLST scheme with 629 genes)</p>
            </div>
        </div>
        
    </section>
    
</body>
</html>
