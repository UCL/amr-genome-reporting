# Project
PROJECT_NAME = "AMR Genome Reporting CLI"
PROJECT_BRIEF = "CLI tool for generation of AMR genome reports"
OUTPUT_DIRECTORY = build/docs

# Input
INPUT = include src
RECURSIVE = YES
FILE_PATTERNS = *.c *.h

# Output formats
GENERATE_HTML = YES
GENERATE_LATEX = NO

# Warnings
WARN_IF_UNDOCUMENTED = YES
WARN_NO_PARAMDOC = YES

# Extraction
EXTRACT_ALL = NO
EXTRACT_STATIC = NO
EXTRACT_PRIVATE = NO

# Formatting
OPTIMIZE_OUTPUT_FOR_C = YES
MARKDOWN_SUPPORT = YES

# Misc
QUIET = YES
